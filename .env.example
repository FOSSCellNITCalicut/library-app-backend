KOHA_BASE_URL=https://opac.nitc.ac.in/api/v1/public
KOHA_USERNAME=
KOHA_PASSWORD=

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-hex-string
# Generate with: openssl rand -hex 32. Required for remember-me feature.
CREDS_ENCRYPTION_KEY=change-me-to-a-random-hex-string

# DB
DATABASE_URL=postgresql+asyncpg://postgres:nitc@localhost:5432/library_app

# Docker host port for the api service (set to 8001 to run api container alongside local uvicorn)
HOST_PORT=8001

# Redis caching (set to False to disable caching entirely)
CACHE_ENABLED=True
REDIS_URL=redis://localhost:6379/0